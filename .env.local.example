# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role (secret!) key — Project Settings > API > service_role.
# Server-only. Never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used to build links in emails/WhatsApp messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Gmail SMTP with an App Password — not your normal password:
# https://myaccount.google.com/apppasswords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# WhatsApp Cloud API — use a permanent System User token (Meta Business
# Suite > Business Settings > System Users), not the 24h quickstart token.
WHATSAPP_TOKEN=your-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
